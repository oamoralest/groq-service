# Groq API Configuration
GROQ_API_KEY=your_api_key_here

# Environment
ENVIRONMENT=development  # development, test, or production

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD=60

# Caching
ENABLE_CACHE=false
CACHE_TTL=3600

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL 